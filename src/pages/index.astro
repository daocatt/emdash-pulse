---
import { getEmDashCollection, getSiteSettings, getTaxonomyTermsWithCacheHint } from "emdash";
import { WidgetArea } from "emdash/ui";
import Base from "../layouts/Base.astro";
import LeadStory from "../components/LeadStory.astro";
import StoryCard from "../components/StoryCard.astro";
import SectionBlock from "../components/SectionBlock.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { formatDate } from "../utils/format";

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveSiteIdentity(settings);

const SECTION_ORDER = ["top", "world", "business", "tech"];

const [latestResult, leadResult, photoResult, termsResult, ...sectionResults] = await Promise.all([
	getEmDashCollection("articles", { orderBy: { published_at: "desc" }, limit: 16 }),
	getEmDashCollection("articles", { where: { priority: "lead" }, orderBy: { published_at: "desc" }, limit: 1 }),
	getEmDashCollection("articles", { where: { article_type: "photo" }, orderBy: { published_at: "desc" }, limit: 3 }),
	getTaxonomyTermsWithCacheHint("section", { includeCounts: false }),
	...SECTION_ORDER.map((slug) =>
		getEmDashCollection("articles", { where: { section: slug }, orderBy: { published_at: "desc" }, limit: 4 }),
	),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(latestResult.cacheHint);
	Astro.cache.set(leadResult.cacheHint);
	Astro.cache.set(photoResult.cacheHint);
	Astro.cache.set(termsResult.cacheHint);
	for (const result of sectionResults) Astro.cache.set(result.cacheHint);
}

const latest = latestResult.entries;
const lead = leadResult.entries[0] ?? latest[0] ?? null;
const secondary = latest.filter((entry) => entry.id !== lead?.id).slice(0, 3);
const photoArticles = photoResult.entries;

const termLabels = new Map(termsResult.data.map((term) => [term.slug, term.label]));
const sections = SECTION_ORDER.map((slug, index) => ({
	slug,
	label: termLabels.get(slug) ?? slug,
	articles: sectionResults[index].entries,
})).filter((section) => section.articles.length > 0);

const siteUrl = Astro.url.origin;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteTitle,
	url: siteUrl,
	description: siteTagline,
};
---

<Base title={siteTitle} description={siteTagline} type="website" jsonLd={jsonLd}>
	<div class="container front">
		{lead && (
			<section class="front__lead" aria-label="头条">
				<LeadStory article={lead} />
			</section>
		)}

		{secondary.length > 0 && (
			<section class="front__secondary" aria-label="次头条">
				{secondary.map((article) => (
					<StoryCard article={article} showImage size="md" headingLevel="h3" />
				))}
			</section>
		)}

		<div class="front__layout">
			<div class="front__main">
				{sections.map((section) => (
					<SectionBlock title={section.label} href={`/sections/${section.slug}`} articles={section.articles} />
				))}

				{photoArticles.length > 0 && <PhotoGrid articles={photoArticles} />}

				{latest.length > 0 && (
					<section class="front__latest">
						<header class="front__latest-header">
							<h2>最新报道</h2>
						</header>
						<ul class="front__latest-list">
							{latest.map((article) => (
								<li>
									<a class="front__latest-link" href={`/articles/${article.id}`}>{article.data.title}</a>
									{article.data.publishedAt && (
										<time class="front__latest-date" datetime={new Date(article.data.publishedAt).toISOString()}>
											{formatDate(article.data.publishedAt)}
										</time>
									)}
								</li>
							))}
						</ul>
					</section>
				)}
			</div>

			<aside class="front__aside" aria-label="侧栏">
				<WidgetArea name="front-sidebar" />
			</aside>
		</div>

		<section class="front__subscribe" aria-label="订阅">
			<SubscribeForm
				heading="订阅 Suda Pulse"
				description="把最新报道送进邮箱，随时可退订。"
				source="front-page"
				compact
			/>
		</section>
	</div>
</Base>

<style>
	.front {
		padding-top: var(--spacing-8);
	}

	.front__lead {
		padding-bottom: var(--spacing-8);
		border-bottom: var(--rule-double);
	}

	.front__secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-6);
		padding-block: var(--spacing-8);
		border-bottom: var(--rule-double);
	}

	@media (min-width: 640px) {
		.front__secondary {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.front__secondary {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.front__layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-10);
	}

	@media (min-width: 1000px) {
		.front__layout {
			grid-template-columns: minmax(0, 1fr) var(--gutter-width);
		}
	}

	.front__latest {
		padding-block: var(--spacing-8);
		border-top: var(--rule-double);
	}

	.front__latest-header h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-5);
	}

	.front__latest-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.front__latest-list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-4);
		padding: var(--spacing-3) 0;
		border-bottom: var(--rule-hairline);
	}

	.front__latest-link {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
	}

	.front__latest-link:hover {
		color: var(--color-brand);
	}

	.front__latest-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		white-space: nowrap;
	}

	.front__aside {
		padding-top: var(--spacing-8);
	}

	@media (min-width: 1000px) {
		.front__aside {
			border-left: var(--rule-hairline);
			padding-left: var(--spacing-8);
		}
	}

	.front__subscribe {
		margin-top: var(--spacing-12);
		padding: var(--spacing-6);
		background: var(--color-bg-subtle);
		border-top: var(--rule-thick);
	}
</style>
