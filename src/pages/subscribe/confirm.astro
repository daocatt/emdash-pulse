---
import Base from "../../layouts/Base.astro";
import { callSubscriptionsRoute } from "../../utils/subscriptions";

// 确认走 SSR：token 即凭证，无需前端 JS。
const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const result = token ? await callSubscriptionsRoute(Astro.locals, "subscribe/confirm", { token }) : null;

const confirmed = result?.ok === true && result.body.status === "confirmed";
const already = result?.body.already === true;
const email = typeof result?.body.email === "string" ? result.body.email : null;
const failure = token ? "确认链接无效或已失效，请重新订阅。" : "确认链接缺少 token。";
---

<Base title="确认订阅" pageTitle="确认订阅" robots="noindex, nofollow">
	<div class="container result">
		<p class="kicker">订阅</p>
		{confirmed ? (
			<>
				<h1 class="result__title">订阅已确认</h1>
				<p class="result__text">
					{already ? "该邮箱此前已完成订阅，无需重复操作。" : "感谢订阅，我们会把最新报道发到你的邮箱。"}
				</p>
				{email && <p class="result__email">{email}</p>}
				<p class="result__actions"><a href="/">返回头版</a></p>
			</>
		) : (
			<>
				<h1 class="result__title">确认失败</h1>
				<p class="result__text">{failure}</p>
				<p class="result__actions"><a href="/subscribe">重新订阅</a></p>
			</>
		)}
	</div>
</Base>

<style>
	.result {
		padding-top: var(--spacing-8);
		max-width: var(--content-width);
	}

	.result__title {
		font-size: var(--font-size-3xl);
		margin: var(--spacing-2) 0 var(--spacing-4);
	}

	.result__text {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	.result__email {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.result__actions {
		margin-top: var(--spacing-6);
	}

	.result__actions a {
		color: var(--color-brand);
	}
</style>
