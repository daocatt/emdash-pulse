---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSiteSettings,
	getSeoMeta,
	decodeSlug,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layout/Base.astro";
import Byline from "@shared/Byline.astro";
import ArticleMeta from "@shared/ArticleMeta.astro";
import Comments from "@shared/Comments.astro";
import CommentForm from "@shared/CommentForm.astro";
import StoryCard from "../../components/StoryCard.astro";
import Gallery from "@shared/Gallery.astro";
import CorrectionNotice from "@shared/CorrectionNotice.astro";
import EpisodePlayer from "@shared/EpisodePlayer.astro";
import { resolveSiteIdentity } from "@utils/site-identity";
import { resolveMediaUrl, resolveMediaAlt, resolveGallery } from "@utils/media";
import { estimateReadingTime } from "@utils/format";
import { getTranslations } from "../../../../i18n";

const { t } = getTranslations(Astro);
const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: article, cacheHint } = await getEmDashEntry("articles", slug);
if (!article) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = article.data;
const settings = await getSiteSettings();
const { siteTitle } = resolveSiteIdentity(settings);
const seo = getSeoMeta(article, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.originPathname.replace(/\/$/, ""),
});

const section = data.terms?.section?.[0] ?? null;
const editionTerm = data.terms?.edition?.[0] ?? null;
const tags = data.terms?.tag ?? [];
const isPhoto = data.article_type === "photo";
const mediaKind =
	data.article_type === "podcast" ? "podcast" : data.article_type === "video" ? "video" : null;
const gallery = resolveGallery(data.gallery);
const image = resolveMediaUrl(data.featured_image);
const imageAlt = resolveMediaAlt(data.featured_image, data.title);
const readingTime = estimateReadingTime(data.content);

// 社交/结构化数据用的图片：SEO 面板图优先，否则回退到题图。
// `getSeoMeta` 不会回退到 `featured_image`，若只依赖它，带图文章也会没有
// `og:image`；且 JSON-LD `image` 需要绝对 URL。
function toAbsolute(href: string | null): string | null {
	if (!href) return null;
	try {
		return new URL(href, Astro.url.origin).href;
	} catch {
		return href;
	}
}
const socialImage = seo.ogImage ?? toAbsolute(image);

const relatedResult = section
	? await getEmDashCollection("articles", {
			where: { section: section.slug },
			orderBy: { published_at: "desc" },
			limit: 4,
		})
	: null;
if (relatedResult && Astro.cache?.enabled) Astro.cache.set(relatedResult.cacheHint);
const related = (relatedResult?.entries ?? []).filter((entry) => entry.id !== article.id).slice(0, 3);

const authorName = data.bylines?.[0]?.byline.displayName ?? data.author_agent ?? siteTitle;
---

<Base
	title={seo.title}
	pageTitle={data.title}
	description={seo.description}
	image={socialImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={data.publishedAt ? new Date(data.publishedAt).toISOString() : undefined}
	modifiedTime={data.updatedAt ? new Date(data.updatedAt).toISOString() : undefined}
	author={authorName}
	content={{ collection: "articles", id: data.id, slug }}
>
	<article class="container article">
		<div class="article__grid">
			<aside class="article__meta-col" aria-label={t("article.info")}>
				<div class="article__byline">
					<Byline bylines={data.bylines} authorAgent={data.author_agent} />
				</div>
				<div class="article__facts">
					<ArticleMeta
						layout="stacked"
						publishedAt={data.publishedAt}
						readingTime={readingTime}
						source={data.source}
						sourceUrl={data.source_url}
					/>
					{editionTerm && (
						<a class="article__edition" href={`/editions/${editionTerm.slug}`}>
							{t("article.edition", { label: editionTerm.label })}
						</a>
					)}
				</div>
				{data.review_status === "approved" && (
					<p class="article__review"><span class="article__review-dot"></span>{t("article.reviewed")}</p>
				)}
			</aside>

			<div class="article__body">
				<header class="article__header">
					{section && <a class="kicker" href={`/sections/${section.slug}`}>{section.label}</a>}
					<h1 class="article__title" {...article.edit.title}>{data.title}</h1>
					{data.deck && <p class="article__deck">{data.deck}</p>}
				</header>

				{data.featured_image && (
					<figure class="article__hero">
						<button
							type="button"
							class="article__hero-zoom"
							data-lightbox
							data-lightbox-src={image}
							data-lightbox-caption={data.image_caption}
							data-lightbox-credit={data.photo_credit}
							aria-label={t("lightbox.zoom")}
						>
							<Image
								image={data.featured_image}
								alt={imageAlt}
								priority
								sizes="(min-width: 900px) 680px, 100vw"
							/>
						</button>
						{(data.image_caption || data.photo_credit) && (
							<figcaption>
								{data.image_caption}
								{data.photo_credit && <span class="article__credit">{data.photo_credit}</span>}
							</figcaption>
						)}
					</figure>
				)}

				{mediaKind && (
					<EpisodePlayer
						kind={mediaKind}
						src={mediaKind === "podcast" ? data.audio_url : data.video_url}
						duration={mediaKind === "podcast" ? data.audio_duration : data.video_duration}
						showName={data.podcast_show}
						episodeNo={data.episode_no}
						title={data.title}
					/>
				)}

				<div class="prose prose--lede" {...article.edit.content}>
					<PortableText value={data.content} />
				</div>

				{gallery.length > 0 && (
					<section class="article__gallery" aria-label={t("article.gallery")}>
						<h2 class="article__gallery-title">{t("article.gallery")}</h2>
						<Gallery items={gallery} groupId={`article-${article.id}`} />
						{data.photo_credit && (
							<p class="article__gallery-credit">{t("article.photoCredit", { name: data.photo_credit })}</p>
						)}
					</section>
				)}

				{data.correction && <CorrectionNotice text={data.correction} date={data.updatedAt} />}

				{tags.length > 0 && (
					<footer class="article__tags">
						<span class="article__tags-label">{t("article.tags")}</span>
						{tags.map((tag) => (
							<a class="article__tag" href={`/tags/${tag.slug}`}>{tag.label}</a>
						))}
					</footer>
				)}

				{data.allow_comments !== false && (
					<section class="article__comments" id="comments" data-reveal>
						<h2 class="article__comments-title">{t("article.comments")}</h2>
						<div class="article__comment-form">
							<CommentForm collection="articles" contentId={data.id} />
						</div>
						<Comments collection="articles" contentId={data.id} threaded />
					</section>
				)}

				{related.length > 0 && (
					<section class="article__related" aria-label={t("article.related")}>
						<h2 class="article__related-title">{t("article.related")}</h2>
						<div class="article__related-grid" data-reveal data-reveal-stagger>
							{related.map((entry) => (
								<StoryCard article={entry} showImage size="sm" headingLevel="h3" />
							))}
						</div>
					</section>
				)}
			</div>

			<aside class="article__aside" aria-label={t("article.aside")}>
				<WidgetArea name="article-aside" />
			</aside>
		</div>

		{isPhoto && gallery.length === 0 && (
			<p class="article__note">{t("article.photoNote")}</p>
		)}
	</article>
</Base>

<style>
	.article {
		padding-top: var(--spacing-8);
	}

	.article__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-6);
	}

	@media (min-width: 900px) {
		.article__grid {
			grid-template-columns: var(--meta-col-width) minmax(0, var(--content-width)) var(--gutter-width);
			gap: var(--spacing-8);
			justify-content: center;
		}
	}

	.article__meta-col {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	@media (min-width: 900px) {
		.article__meta-col {
			position: sticky;
			top: var(--spacing-6);
			align-self: start;
			border-right: var(--rule-hairline);
			padding-right: var(--spacing-5);
		}
	}

	.article__byline {
		padding-bottom: var(--spacing-3);
		border-bottom: var(--rule-hairline);
	}

	.article__facts {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.article__review {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		padding-top: var(--spacing-3);
		border-top: var(--rule-hairline);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.article__edition {
		font-size: var(--font-size-xs);
		color: var(--color-brand);
		letter-spacing: var(--tracking-wide);
	}

	.article__edition:hover {
		text-decoration: underline;
	}

	.article__review-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-brand);
	}

	.article__title {
		font-size: var(--font-size-5xl);
		margin-top: var(--spacing-3);
	}

	@media (max-width: 640px) {
		.article__title {
			font-size: var(--font-size-3xl);
		}
	}

	.article__deck {
		margin: var(--spacing-4) 0 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: var(--leading-snug);
		color: var(--color-text-secondary);
	}

	.article__hero {
		margin: var(--spacing-8) 0;
	}

	/* 题图本身是灯箱触发器：去掉按钮默认样式，只留「可放大」的光标提示 */
	.article__hero-zoom {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: zoom-in;
	}

	.article__hero img {
		width: 100%;
	}

	.article__hero figcaption {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-4);
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.article__credit {
		white-space: nowrap;
	}

	.article__gallery {
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-6);
		border-top: var(--rule-double);
	}

	.article__gallery-title {
		font-size: var(--font-size-2xl);
	}

	.article__gallery-credit {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.article__tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3);
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-5);
		border-top: var(--rule-hairline);
	}

	.article__tags-label {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	.article__tag {
		font-size: var(--font-size-sm);
		padding: 2px 10px;
		border: var(--rule-hairline);
		color: var(--color-text-secondary);
	}

	.article__tag:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.article__aside {
		display: none;
	}

	@media (min-width: 1100px) {
		.article__aside {
			display: block;
			border-left: var(--rule-hairline);
			padding-left: var(--spacing-6);
		}
	}

	.article__note {
		margin-top: var(--spacing-6);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.article__comments {
		margin-top: var(--spacing-16);
		padding-top: var(--spacing-8);
		border-top: var(--rule-thick);
	}

	.article__comments-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-5);
	}

	.article__comment-form {
		margin-bottom: var(--spacing-8);
	}

	.article__related {
		margin-top: var(--spacing-16);
		padding-top: var(--spacing-8);
		border-top: var(--rule-double);
	}

	.article__related-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.article__related-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-6);
	}

	@media (min-width: 700px) {
		.article__related-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
