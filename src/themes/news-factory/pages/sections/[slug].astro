---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, decodeSlug } from "emdash";
import Base from "../../layout/Base.astro";
import StoryCard from "../../components/StoryCard.astro";
import Pagination from "@shared/Pagination.astro";
import { getTranslations } from "../../../../i18n";

const PER_PAGE = 12;

const { t } = getTranslations(Astro);
const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("section", { includeCounts: true });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;
if (!term) return Astro.redirect("/404");

const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);

const { entries: articles, cacheHint, hasMore } = await getEmDashCollection("articles", {
	where: { section: term.slug },
	orderBy: { published_at: "desc" },
	limit: PER_PAGE,
	offset: (page - 1) * PER_PAGE,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={t("list.sectionTitle", { label: term.label })}
	pageTitle={term.label}
	description={t("list.sectionDescription", { label: term.label })}
	canonical={`${Astro.url.origin}/sections/${term.slug}`}
>
	<div class="container archive-page">
		<header class="archive-page__header">
			<span class="kicker">{t("list.sectionKicker")}</span>
			<h1 class="archive-page__title">{term.label}</h1>
			{term.description && <p class="archive-page__desc">{term.description}</p>}
			<p class="archive-page__count">{t("list.count", { count: term.count ?? articles.length })}</p>
		</header>

		{articles.length === 0 ? (
			<p class="archive-page__empty">{t("list.emptySection")}</p>
		) : (
			<ul class="archive-page__list" data-reveal data-reveal-stagger>
				{articles.map((article) => (
					<li class="archive-page__row">
						<StoryCard article={article} showImage size="md" headingLevel="h2" />
					</li>
				))}
			</ul>
		)}

		<Pagination page={page} hasMore={Boolean(hasMore)} basePath={`/sections/${term.slug}`} />
	</div>
</Base>

<style>
	.archive-page {
		padding-top: var(--spacing-8);
	}

	.archive-page__header {
		padding-bottom: var(--spacing-5);
		border-bottom: var(--rule-double);
		margin-bottom: var(--spacing-8);
	}

	.archive-page__title {
		font-size: var(--font-size-5xl);
		margin-top: var(--spacing-2);
	}

	.archive-page__desc {
		margin: var(--spacing-3) 0 0;
		color: var(--color-text-secondary);
	}

	.archive-page__count {
		margin: var(--spacing-3) 0 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.archive-page__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
	}

	@media (min-width: 700px) {
		.archive-page__list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.archive-page__list {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.archive-page__row {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		padding-bottom: var(--spacing-6);
		border-bottom: var(--rule-hairline);
	}

	.archive-page__empty {
		padding: var(--spacing-16) 0;
		text-align: center;
		color: var(--color-muted);
	}
</style>
