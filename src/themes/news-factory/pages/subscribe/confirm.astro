---
import Base from "../../layout/Base.astro";
import { callSubscriptionsRoute } from "@utils/subscriptions";
import { getTranslations } from "../../../../i18n";

const { t } = getTranslations(Astro);

// 确认走 SSR：token 即凭证，无需前端 JS。
const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const result = token ? await callSubscriptionsRoute(Astro.locals, "subscribe/confirm", { token }) : null;

const confirmed = result?.ok === true && result.body.status === "confirmed";
const already = result?.body.already === true;
const email = typeof result?.body.email === "string" ? result.body.email : null;
const failure = token ? t("subscribePage.confirmInvalid") : t("subscribePage.confirmMissingToken");
---

<Base title={t("subscribePage.confirmTitle")} pageTitle={t("subscribePage.confirmTitle")} robots="noindex, nofollow">
	<div class="container result">
		<p class="kicker">{t("common.subscribe")}</p>
		{confirmed ? (
			<>
				<h1 class="result__title">{t("subscribePage.confirmHeading")}</h1>
				<p class="result__text">
					{already ? t("subscribePage.confirmAlready") : t("subscribePage.confirmThanks")}
				</p>
				{email && <p class="result__email">{email}</p>}
				<p class="result__actions"><a href="/">{t("common.backHome")}</a></p>
			</>
		) : (
			<>
				<h1 class="result__title">{t("subscribePage.confirmFailed")}</h1>
				<p class="result__text">{failure}</p>
				<p class="result__actions"><a href="/subscribe">{t("subscribePage.resubscribe")}</a></p>
			</>
		)}
	</div>
</Base>

<style>
	.result {
		padding-top: var(--spacing-8);
		max-width: var(--content-width);
	}

	.result__title {
		font-size: var(--font-size-3xl);
		margin: var(--spacing-2) 0 var(--spacing-4);
	}

	.result__text {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	.result__email {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.result__actions {
		margin-top: var(--spacing-6);
	}

	.result__actions a {
		color: var(--color-brand);
	}
</style>
