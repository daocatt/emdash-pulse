---
import Base from "../../layout/Base.astro";
import { callSubscriptionsRoute } from "@utils/subscriptions";

// 退订走 SSR：token 即凭证，无需前端 JS。
const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const result = token ? await callSubscriptionsRoute(Astro.locals, "unsubscribe", { token }) : null;

const unsubscribed = result?.ok === true && result.body.status === "unsubscribed";
const email = typeof result?.body.email === "string" ? result.body.email : null;
const failure = token ? "退订链接无效或已失效。" : "退订链接缺少 token。";
---

<Base title="退订" pageTitle="退订" robots="noindex, nofollow">
	<div class="container result">
		<p class="kicker">订阅</p>
		{unsubscribed ? (
			<>
				<h1 class="result__title">已退订</h1>
				<p class="result__text">我们不会再向该邮箱发送订阅邮件。</p>
				{email && <p class="result__email">{email}</p>}
				<p class="result__actions"><a href="/subscribe">重新订阅</a></p>
			</>
		) : (
			<>
				<h1 class="result__title">退订失败</h1>
				<p class="result__text">{failure}</p>
				<p class="result__actions"><a href="/">返回头版</a></p>
			</>
		)}
	</div>
</Base>

<style>
	.result {
		padding-top: var(--spacing-8);
		max-width: var(--content-width);
	}

	.result__title {
		font-size: var(--font-size-3xl);
		margin: var(--spacing-2) 0 var(--spacing-4);
	}

	.result__text {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	.result__email {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.result__actions {
		margin-top: var(--spacing-6);
	}

	.result__actions a {
		color: var(--color-brand);
	}
</style>
