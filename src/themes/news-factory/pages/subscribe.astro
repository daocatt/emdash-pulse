---
import { getSiteSettings } from "emdash";
import Base from "../layout/Base.astro";
import SubscribeForm from "@shared/SubscribeForm.astro";
import { getTranslations } from "../../../i18n";
import { resolveSiteIdentity } from "@utils/site-identity";
import { fetchActiveGroups } from "@utils/subscriptions";

const { t } = getTranslations(Astro);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());
const siteUrl = Astro.url.origin;
const groups = await fetchActiveGroups(Astro.locals);
---

<Base
	title={t("subscribePage.title")}
	pageTitle={t("subscribePage.title")}
	description={t("subscribePage.description", { siteTitle })}
	canonical={`${siteUrl}/subscribe`}
>
	<div class="container subscribe">
		<header class="subscribe__header">
			<p class="kicker">Newsletter</p>
			<h1 class="subscribe__title">{t("subscribePage.heading", { siteTitle })}</h1>
			<p class="subscribe__lede">{t("subscribePage.lede")}</p>
		</header>

		<div class="subscribe__form">
			<SubscribeForm
				heading={t("subscribePage.formHeading")}
				description={t("subscribePage.formHint")}
				source="subscribe-page"
				groups={groups}
			/>
		</div>

		<div class="subscribe__notes prose">
			<h2>{t("subscribePage.flow")}</h2>
			<ol>
				<li>{t("subscribePage.step1")}</li>
				<li>{t("subscribePage.step2")}</li>
				<li>{t("subscribePage.step3")}</li>
			</ol>
		</div>
	</div>
</Base>

<style>
	.subscribe {
		padding-top: var(--spacing-8);
		max-width: var(--content-width);
	}

	.subscribe__header {
		padding-bottom: var(--spacing-4);
		border-bottom: var(--rule-double);
	}

	.subscribe__title {
		font-size: var(--font-size-4xl);
		margin: var(--spacing-2) 0;
	}

	.subscribe__lede {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	.subscribe__form {
		margin-top: var(--spacing-8);
		padding: var(--spacing-6);
		background: var(--color-bg-subtle);
		border: var(--rule-hairline);
	}

	.subscribe__notes {
		margin-top: var(--spacing-10);
	}
</style>
