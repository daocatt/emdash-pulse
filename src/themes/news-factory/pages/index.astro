---
/**
 * news-factory 头版：三栏报纸版面。
 *
 * 左栏三条纯文字稿 + 订阅通讯卡；中栏主稿（大图）+ 两条图文横排；
 * 右栏热门/最新排行榜 + 视频卡 + 后台可配的侧栏组件区；底部「更多头条」。
 *
 * 数据编排只在这里做：查询 → cacheHint → 去重切片 → 交给纯展示组件。
 */
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layout/Base.astro";
import InlineStory from "../components/InlineStory.astro";
import MainStory from "../components/MainStory.astro";
import MoreStories from "../components/MoreStories.astro";
import RankList from "../components/RankList.astro";
import TextBrief from "../components/TextBrief.astro";
import VideoCard from "../components/VideoCard.astro";
import SubscribeForm from "@shared/SubscribeForm.astro";
import { getTranslations } from "../../../i18n";
import { whereClause } from "@utils/query";
import { resolveSiteIdentity } from "@utils/site-identity";

const { t } = getTranslations(Astro);

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveSiteIdentity(settings);

const [latestResult, leadResult, featuredResult, videoResult, trendingResult] = await Promise.all([
	getEmDashCollection("articles", { orderBy: { published_at: "desc" }, limit: 12 }),
	getEmDashCollection("articles", {
		where: { priority: "lead" },
		orderBy: { published_at: "desc" },
		limit: 1,
	}),
	getEmDashCollection("articles", {
		where: whereClause({ is_featured: true }),
		orderBy: { published_at: "desc" },
		limit: 5,
	}),
	getEmDashCollection("articles", {
		where: { article_type: "video" },
		orderBy: { published_at: "desc" },
		limit: 1,
	}),
	// 编辑部标的当日热度榜（trending_rank 为 indexed 字段）；`gte` 顺带排除未标记的 NULL
	getEmDashCollection("articles", {
		where: { trending_rank: { gte: "1" } },
		orderBy: { trending_rank: "asc" },
		limit: 5,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(latestResult.cacheHint);
	Astro.cache.set(leadResult.cacheHint);
	Astro.cache.set(featuredResult.cacheHint);
	Astro.cache.set(videoResult.cacheHint);
	Astro.cache.set(trendingResult.cacheHint);
}

const latest = latestResult.entries;
const lead = leadResult.entries[0] ?? latest[0] ?? null;
const video =
	videoResult.entries[0] ?? latest.find((article) => article.data.article_type === "video") ?? null;

// 主稿与视频稿先定位再排除，其余按时间顺序铺开：左栏 3 条 → 中栏 2 条
const pool = latest.filter((article) => article.id !== lead?.id && article.id !== video?.id);
const briefs = pool.slice(0, 3);
const inline = pool.slice(3, 5);

const placed = new Set<string | undefined>([
	lead?.id,
	video?.id,
	...briefs.map((article) => article.id),
	...inline.map((article) => article.id),
]);

// 底部「更多头条」：优先未上版面的稿子；内容不足时按设计稿补位
// （设计稿的 MORE TOP STORIES 本就与左栏有重复），只排除主稿与视频稿以免大图重复。
const unplaced = pool.filter((article) => !placed.has(article.id));
const fillers = latest.filter(
	(article) => article.id !== lead?.id && article.id !== video?.id && placed.has(article.id),
);
const more = [...unplaced, ...fillers].slice(0, 4);

// 右栏「热门话题」：优先按编辑部标记的 trending_rank 升序，其次编辑推荐（is_featured），
// 仍不足 5 条时用最新稿补位。
const ranked = trendingResult.entries;
const featured = featuredResult.entries;
const trending = [
	...ranked,
	...featured.filter((entry) => !ranked.some((item) => item.id === entry.id)),
	...latest.filter(
		(article) =>
			!ranked.some((item) => item.id === article.id) &&
			!featured.some((entry) => entry.id === article.id),
	),
].slice(0, 5);
const latestFive = latest.slice(0, 5);
---

<Base title={siteTitle} description={siteTagline} type="website">
	<div class="container front">
		<div class="front__grid">
			<div class="front__col front__col--left">
				{briefs.map((article) => <TextBrief article={article} />)}

				<SubscribeForm
					variant="card"
					heading={t("nf.newsletter")}
					description={t("nf.newsletterHint")}
					source="front-page"
				/>
			</div>

			<div class="front__col front__col--center">
				{lead && <MainStory article={lead} />}

				{
					inline.length > 0 && (
						<div class="front__inline">
							{inline.map((article) => (
								<InlineStory article={article} />
							))}
						</div>
					)
				}
			</div>

			<aside class="front__col front__col--right" aria-label={t("nf.aside")}>
				<RankList trending={trending} latest={latestFive} />

				{video && <VideoCard article={video} />}
			</aside>
		</div>

		<MoreStories articles={more} />
	</div>
</Base>

<style>
	.front {
		padding-top: var(--spacing-10);
	}

	.front__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
	}

	.front__col {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
		min-width: 0;
	}

	.front__col--left > * + * {
		padding-top: var(--spacing-6);
		border-top: var(--rule-hairline);
	}

	.front__inline {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
		padding-top: var(--spacing-6);
		border-top: var(--rule-hairline);
	}

	/* 窄屏单列时把主稿提到最前，别让头条压在简讯和订阅卡下面 */
	@media (max-width: 899px) {
		.front__col--center {
			order: -1;
		}
	}

	@media (min-width: 900px) {
		.front__grid {
			grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 3fr);
			gap: 0;
		}

		.front__col {
			padding-inline: var(--spacing-6);
		}

		.front__col--left {
			padding-left: 0;
			border-right: var(--rule-hairline);
		}

		.front__col--right {
			padding-right: 0;
			border-left: var(--rule-hairline);
		}
	}
</style>
