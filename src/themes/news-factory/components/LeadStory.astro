---
import { Image } from "emdash/ui";
import type { ArticleEntry } from "@utils/types";
import { resolveMediaAlt } from "@utils/media";
import { formatDate } from "@utils/format";
import Byline from "@shared/Byline.astro";

interface Props {
	article: ArticleEntry;
	class?: string;
}

const { article, class: className } = Astro.props;
const data = article.data;
const href = `/articles/${article.id}`;
const alt = resolveMediaAlt(data.featured_image, data.title);
const section = data.terms?.section?.[0];
const isPhoto = data.article_type === "photo";
---

<article class:list={["lead-story", className]}>
	{data.featured_image && (
		<a class="lead-story__media" href={href} tabindex="-1" aria-hidden="true">
			<Image
				image={data.featured_image}
				alt={alt}
				priority
				sizes="(min-width: 900px) 58vw, 100vw"
			/>
			{data.image_caption && <span class="lead-story__caption">{data.image_caption}</span>}
		</a>
	)}

	<div class="lead-story__body">
		<div class="lead-story__topline">
			{data.is_breaking && <span class="lead-story__breaking">突发</span>}
			{isPhoto && <span class="kicker">图片新闻</span>}
			{section && <a class="kicker lead-story__section" href={`/sections/${section.slug}`}>{section.label}</a>}
		</div>

		<h2 class="lead-story__title">
			<a href={href} {...article.edit.title}>{data.title}</a>
		</h2>

		{(data.deck || data.excerpt) && <p class="lead-story__deck">{data.deck || data.excerpt}</p>}

		<div class="lead-story__footer">
			<Byline bylines={data.bylines} authorAgent={data.author_agent} />
			{data.publishedAt && <time datetime={new Date(data.publishedAt).toISOString()}>{formatDate(data.publishedAt)}</time>}
		</div>
	</div>
</article>

<style>
	.lead-story {
		display: grid;
		gap: var(--spacing-5);
	}

	@media (min-width: 900px) {
		.lead-story {
			grid-template-columns: 1.4fr 1fr;
			align-items: start;
			gap: var(--spacing-8);
		}
	}

	.lead-story__media {
		display: block;
		position: relative;
		overflow: hidden;
		background: var(--color-bg-subtle);
		aspect-ratio: 16 / 10;
	}

	.lead-story__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.lead-story__media:hover img {
		transform: scale(1.02);
	}

	.lead-story__caption {
		position: absolute;
		inset: auto 0 0 0;
		padding: var(--spacing-2) var(--spacing-3);
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
		color: #fff;
		font-size: var(--font-size-xs);
	}

	.lead-story__topline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-3);
	}

	.lead-story__section:hover {
		color: var(--color-brand-hover);
		text-decoration: underline;
	}

	.lead-story__breaking {
		display: inline-block;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wide);
		padding: 1px 6px;
	}

	.lead-story__title {
		font-size: var(--font-size-4xl);
		line-height: var(--leading-tight);
	}

	@media (min-width: 900px) {
		.lead-story__title {
			font-size: var(--font-size-5xl);
		}
	}

	.lead-story__title a:hover {
		color: var(--color-brand);
	}

	.lead-story__deck {
		margin: var(--spacing-4) 0 0;
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		color: var(--color-text-secondary);
	}

	.lead-story__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-2) var(--spacing-4);
		margin-top: var(--spacing-5);
		padding-top: var(--spacing-3);
		border-top: var(--rule-hairline);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
</style>
