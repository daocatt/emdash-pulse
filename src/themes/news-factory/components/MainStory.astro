---
/**
 * 主稿（头版中栏顶部）：大图 + 红色「主稿」标 + 大标题 + 摘要 + 署名。
 */
import { Image } from "emdash/ui";
import type { ArticleEntry } from "@utils/types";
import Byline from "@shared/Byline.astro";
import { getTranslations } from "../../../i18n";
import { formatDate } from "@utils/format";
import { resolveMediaAlt } from "@utils/media";

interface Props {
	article: ArticleEntry;
	class?: string;
}

const { article, class: className } = Astro.props;
const { locale, t } = getTranslations(Astro);
const data = article.data;
const href = `/articles/${article.id}`;
const publishedAt = data.publishedAt ?? data.createdAt;
const section = data.terms?.section?.[0];
---

<article class:list={["main-story", className]}>
	{data.featured_image && (
		<a class="main-story__media" href={href} tabindex="-1" aria-hidden="true">
			<Image
				image={data.featured_image}
				alt={resolveMediaAlt(data.featured_image, data.title)}
				sizes="(min-width: 1100px) 45vw, 100vw"
				priority
			/>
			<span class="main-story__label">{t("nf.mainStory")}</span>
		</a>
	)}

	<div class="main-story__topline">
		{data.is_breaking && <span class="main-story__breaking">{t("nf.breaking")}</span>}
		{section && (
			<a class="kicker" href={`/sections/${section.slug}`}>{section.label}</a>
		)}
	</div>

	<h2 class="main-story__title">
		<a href={href} {...article.edit.title}>{data.title}</a>
	</h2>

	{(data.deck || data.excerpt) && <p class="main-story__deck">{data.deck || data.excerpt}</p>}

	<div class="main-story__meta">
		<Byline bylines={data.bylines} authorAgent={data.author_agent} accent />
		{publishedAt && (
			<time class="main-story__date" datetime={new Date(publishedAt).toISOString()}>
				{formatDate(publishedAt, locale)}
			</time>
		)}
	</div>
</article>

<style>
	.main-story {
		display: flex;
		flex-direction: column;
	}

	.main-story__media {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--color-bg-subtle);
		aspect-ratio: 16 / 10;
		margin-bottom: var(--spacing-5);
	}

	.main-story__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.main-story__media:hover img {
		transform: scale(1.02);
	}

	.main-story__label {
		position: absolute;
		top: var(--spacing-4);
		left: var(--spacing-4);
		padding: var(--spacing-1) var(--spacing-3);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.main-story__topline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-3);
	}

	.main-story__breaking {
		display: inline-block;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wide);
		padding: 1px 6px;
	}

	.main-story__title {
		font-size: var(--font-size-4xl);
		line-height: var(--leading-tight);
	}

	.main-story__title a:hover {
		color: var(--color-brand);
	}

	.main-story__deck {
		margin: var(--spacing-4) 0 0;
		font-size: var(--font-size-base);
		line-height: var(--leading-snug);
		color: var(--color-text-secondary);
	}

	.main-story__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-top: var(--spacing-5);
		padding-top: var(--spacing-3);
		border-top: var(--rule-hairline);
	}

	.main-story__date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.main-story__title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
