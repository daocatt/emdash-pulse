---
/**
 * 右栏视频卡：封面 + 播放标 + 时长角标 + 标题 + 署名。
 *
 * `video_duration` / `video_url` 属于内容模型扩展（P4），当前可能为空，
 * 因此时长角标与播放标都按有无数据渲染。
 */
import { Image } from "emdash/ui";
import type { ArticleEntry } from "@utils/types";
import Byline from "@shared/Byline.astro";
import { getTranslations } from "../../../i18n";
import { formatDate } from "@utils/format";
import { resolveMediaAlt } from "@utils/media";

interface Props {
	article: ArticleEntry;
	class?: string;
}

const { article, class: className } = Astro.props;
const { locale, t } = getTranslations(Astro);
const data = article.data;
const href = `/articles/${article.id}`;
const publishedAt = data.publishedAt ?? data.createdAt;
const duration = (data as { video_duration?: string | null }).video_duration ?? null;
---

<article class:list={["video-card", className]} data-hover-lift>
	<a class="video-card__media" href={href} tabindex="-1" aria-hidden="true">
		{data.featured_image ? (
			<Image
				image={data.featured_image}
				alt={resolveMediaAlt(data.featured_image, data.title)}
				sizes="(min-width: 1100px) 320px, 100vw"
			/>
		) : (
			<span class="video-card__placeholder" />
		)}
		<span class="video-card__play">▶ {t("nf.playVideo")}</span>
		{duration && <span class="video-card__duration">{duration}</span>}
	</a>

	<h3 class="video-card__title">
		<a href={href} {...article.edit.title}>{data.title}</a>
	</h3>

	<div class="video-card__meta">
		<Byline bylines={data.bylines} authorAgent={data.author_agent} compact accent />
		{publishedAt && (
			<time class="video-card__date" datetime={new Date(publishedAt).toISOString()}>
				{formatDate(publishedAt, locale)}
			</time>
		)}
	</div>
</article>

<style>
	.video-card__media {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--color-bg-subtle);
		aspect-ratio: 16 / 9;
		margin-bottom: var(--spacing-4);
	}

	.video-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.video-card__media:hover img {
		transform: scale(1.03);
	}

	.video-card__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-bg-subtle);
	}

	.video-card__play {
		position: absolute;
		left: var(--spacing-3);
		bottom: var(--spacing-3);
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
		padding: var(--spacing-1) var(--spacing-3);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-xs);
		font-weight: 700;
	}

	.video-card__duration {
		position: absolute;
		right: var(--spacing-3);
		bottom: var(--spacing-3);
		padding: 1px 6px;
		background: color-mix(in srgb, var(--color-text) 75%, transparent);
		color: var(--color-bg);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.video-card__title {
		font-size: var(--font-size-xl);
		line-height: var(--leading-snug);
	}

	.video-card__title a:hover {
		color: var(--color-brand);
	}

	.video-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-2);
		margin-top: var(--spacing-3);
	}

	.video-card__date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		white-space: nowrap;
	}
</style>
