---
/**
 * 报头：左搜索、中站名、右登录 / 订阅按钮（三栏，窄屏堆叠）。
 */
import LiveSearch from "emdash/ui/search";
import { getTranslations } from "../../../i18n";

interface Props {
	siteTitle: string;
	siteTagline: string;
	class?: string;
}

const { siteTitle, siteTagline, class: className } = Astro.props;
const { t } = getTranslations(Astro);
const isHome = (Astro.url.pathname.replace(/\/$/, "") || "/") === "/";
const BrandTag = isHome ? "h1" : "div";
---

<header class:list={["masthead", className]}>
	<div class="masthead__search">
		<LiveSearch
			placeholder={t("common.searchPlaceholder")}
			collections={["articles", "pages"]}
			searchPage="/search"
			routeMap={{ articles: "/articles/:slug", pages: "/pages/:slug" }}
		/>
	</div>

	<div class="masthead__brand">
		<BrandTag class="masthead__title">
			<a class="masthead__title-link" href="/">{siteTitle}</a>
		</BrandTag>
		<p class="masthead__tagline">{siteTagline}</p>
	</div>

	<div class="masthead__actions">
		<a class="masthead__login" href="/_emdash/admin">{t("nf.login")}</a>
		<a class="masthead__subscribe" href="/subscribe">{t("nf.subscribeCta")}</a>
	</div>
</header>

<style>
	.masthead {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: var(--spacing-4);
		padding-block: var(--spacing-6);
		border-bottom: var(--rule-hairline);
	}

	.masthead__search {
		max-width: 320px;
	}

	.masthead__brand {
		text-align: center;
	}

	.masthead__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-6xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: 1;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.masthead__title-link {
		display: inline-block;
		color: inherit;
	}

	.masthead__title-link:hover {
		color: var(--color-text);
	}

	.masthead__tagline {
		margin: var(--spacing-3) 0 0;
		font-family: var(--font-heading);
		font-style: italic;
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
	}

	.masthead__actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--spacing-5);
	}

	.masthead__login {
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.masthead__subscribe {
		display: inline-block;
		padding: var(--spacing-3) var(--spacing-5);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		white-space: nowrap;
	}

	.masthead__subscribe:hover {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	@media (min-width: 900px) {
		.masthead {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			gap: var(--spacing-8);
		}
	}

	@media (max-width: 899px) {
		.masthead__brand {
			order: -1;
		}

		.masthead__actions {
			justify-content: center;
		}

		.masthead__search {
			margin-inline: auto;
			width: 100%;
		}
	}

	@media (max-width: 640px) {
		.masthead__title {
			font-size: var(--font-size-4xl);
		}
	}
</style>
