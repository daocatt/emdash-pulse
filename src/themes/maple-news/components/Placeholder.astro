---
interface Props {
	heading: string;
	note?: string;
}

const {
	heading,
	note = "该页面在 Maple News 主题下尚未实现（P3 / P5 阶段补齐）。",
} = Astro.props;
---

<section class="placeholder">
	<h1 class="placeholder__heading">{heading}</h1>
	<p class="placeholder__note">{note}</p>
</section>

<style>
	.placeholder {
		padding-block: var(--spacing-12);
	}

	.placeholder__heading {
		font-size: var(--font-size-3xl);
		margin: 0 0 var(--spacing-4);
	}

	.placeholder__note {
		color: var(--color-muted);
		margin: 0;
	}
</style>
