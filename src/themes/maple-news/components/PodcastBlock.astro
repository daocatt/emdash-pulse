---
/**
 * 播客区块（设计稿 UI-2 右栏顶部）：耳机图标 + 栏目名 + 单集标题 + 播放条 + 主播卡。
 *
 * `audio_url` / `audio_duration` / `podcast_show` 属于内容模型扩展（P4），当前可能为空，
 * 所以栏目名、时长都按有无数据渲染；播放条是装饰（真正可播的音频端点随 P4 决定），
 * 标题本身是通往单集页的链接。
 */
import type { ArticleEntry } from "@utils/types";
import AuthorCard from "@shared/AuthorCard.astro";
import { getTranslations } from "../../../i18n";

interface Props {
	article: ArticleEntry;
	class?: string;
}

const { article, class: className } = Astro.props;
const { t } = getTranslations(Astro);
const data = article.data;

// P4 才落库的字段，先按可选读取
const podcast = data as {
	audio_duration?: string | null;
	podcast_show?: string | null;
};

const credit = data.bylines?.[0];
const publishedAt = data.publishedAt ?? data.createdAt;
---

<article class:list={["podcast", className]}>
	<h2 class="podcast__heading">
		<svg class="podcast__icon" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M6 4h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-4l-4 3v-3H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linejoin="round"
			/>
			<path d="M9 9v3M12 7.5v6M15 9v3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
		</svg>
		<span class="podcast__label">{t("mn.podcast")}</span>
	</h2>

	{podcast.podcast_show && <p class="podcast__show">{podcast.podcast_show}</p>}

	<h3 class="podcast__title">
		<a href={`/articles/${article.id}`} {...article.edit.title}>{data.title}</a>
	</h3>

	<div class="podcast__player" aria-hidden="true">
		<span class="podcast__play">
			<svg viewBox="0 0 12 12"><path d="M2 1.2 10.4 6 2 10.8Z" fill="currentColor" /></svg>
		</span>
		<span class="podcast__track"><span class="podcast__fill" /></span>
		{podcast.audio_duration && <span class="podcast__duration">{podcast.audio_duration}</span>}
	</div>

	{credit && (
		<div class="podcast__host">
			<AuthorCard
				byline={credit.byline}
				roleLabel={credit.roleLabel}
				date={publishedAt}
				size="sm"
			/>
		</div>
	)}
</article>

<style>
	.podcast__heading {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin: 0;
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-2xl);
	}

	.podcast__icon {
		flex: none;
		width: 1.6em;
		height: 1.6em;
		color: var(--color-text);
	}

	.podcast__show {
		margin: var(--spacing-1) 0 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.podcast__title {
		margin: var(--spacing-5) 0 0;
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-xl);
		line-height: var(--leading-snug);
		text-transform: uppercase;
	}

	.podcast__title a:hover {
		color: var(--color-brand);
	}

	.podcast__player {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-top: var(--spacing-5);
	}

	.podcast__play {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 1.6rem;
		background: var(--color-text);
		color: var(--color-bg);
		border-radius: var(--radius);
	}

	.podcast__play svg {
		width: 0.7rem;
		height: 0.7rem;
	}

	.podcast__track {
		flex: 1;
		height: 4px;
		background: var(--color-border);
		border-radius: 2px;
		overflow: hidden;
	}

	.podcast__fill {
		display: block;
		width: 32%;
		height: 100%;
		background: var(--color-brand);
	}

	.podcast__duration {
		flex: none;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.podcast__host {
		margin-top: var(--spacing-5);
		padding-top: var(--spacing-5);
		border-top: 1px solid var(--color-border);
	}
</style>
