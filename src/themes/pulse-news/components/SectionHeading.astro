---
/**
 * 区块标题：大号粗斜体衬线 + 手绘下划线 + 右侧延伸细线（设计稿 UI-2 的
 * 「Latest Updates」）。
 *
 * 下划线用内联 SVG：路径按 `preserveAspectRatio="none"` 拉伸铺满文字宽度，
 * 再用 `vector-effect="non-scaling-stroke"` 把线宽固定在设备像素上 ——
 * 否则非等比缩放会把笔画压扁。
 */
interface Props {
	title: string;
	/** 标题层级，默认 h2。 */
	as?: "h1" | "h2" | "h3";
	class?: string;
}

const { title, as: Tag = "h2", class: className } = Astro.props;
---

<header class:list={["section-heading", className]}>
	<Tag class="section-heading__title">
		<span class="section-heading__text">
			{title}
			<svg
				class="section-heading__stroke"
				viewBox="0 0 240 14"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path d="M3 6.6C49 3.4 95 11.3 149 9.9C185 8.9 214 5.2 237 3.9" />
			</svg>
		</span>
	</Tag>
	<span class="section-heading__rule" aria-hidden="true" />
</header>

<style>
	.section-heading {
		display: flex;
		align-items: center;
		gap: var(--spacing-6);
		margin-bottom: var(--spacing-8);
	}

	.section-heading__title {
		margin: 0;
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-3xl);
		letter-spacing: var(--tracking-snug);
		line-height: var(--leading-tight);
		white-space: nowrap;
	}

	.section-heading__text {
		position: relative;
		display: inline-block;
	}

	.section-heading__stroke {
		position: absolute;
		left: -2%;
		bottom: -0.32em;
		width: 104%;
		height: 0.4em;
		fill: none;
		stroke: var(--color-brand-soft);
		stroke-width: 3;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.section-heading__rule {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}
</style>
