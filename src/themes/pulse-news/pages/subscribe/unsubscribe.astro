---
/**
 * pulse-news 订阅管理页（由退订页演进而来）。
 *
 * **打开即退订**是旧行为，已废弃：邮件客户端与安全扫描器会预取邮件里的链接，
 * 那样会把人悄悄退订掉。现在 GET 只做只读展示，退订与改分组都是显式 POST。
 *
 * 无 JS 可用：全部走原生 `<form method="post">` + SSR 调插件公开路由（token 即凭证）。
 * 状态机在 `@utils/subscriptions` 的 `resolveManageOutcome`，这里只负责渲染。
 */
import Base from "../../layout/Base.astro";
import { resolveManageOutcome } from "@utils/subscriptions";
import { getTranslations } from "../../../../i18n";

const { t } = getTranslations(Astro);

const isPost = Astro.request.method === "POST";
const form = isPost ? await Astro.request.formData() : null;

const outcome = await resolveManageOutcome(Astro.locals, {
	method: Astro.request.method,
	token: (isPost ? String(form?.get("token") ?? "") : (Astro.url.searchParams.get("token") ?? "")).trim(),
	intent: isPost ? String(form?.get("intent") ?? "") : "",
	groups: form?.getAll("groups").map((value) => String(value)) ?? [],
	cadence: isPost ? String(form?.get("cadence") ?? "").trim() : "",
	reason: isPost ? String(form?.get("reason") ?? "").trim() : "",
});

const manage = outcome.kind === "manage" ? outcome : null;
const pageTitle =
	outcome.kind === "unsubscribed" ? t("subscribePage.unsubscribeTitle") : t("subscribeManage.title");
---

<Base title={pageTitle} pageTitle={pageTitle} robots="noindex, nofollow">
	<div class="container manage">
		{outcome.kind === "missingToken" || outcome.kind === "invalidToken" ? (
			<div class="manage__result">
				<h1 class="manage__result-title">{t("subscribePage.unsubscribeFailed")}</h1>
				<p class="manage__result-text">
					{outcome.kind === "missingToken"
						? t("subscribePage.unsubscribeMissingToken")
						: t("subscribePage.unsubscribeInvalid")}
				</p>
				<p class="manage__result-actions"><a href="/">{t("common.backHome")}</a></p>
			</div>
		) : outcome.kind === "unsubscribed" ? (
			<div class="manage__result">
				<h1 class="manage__result-title">{t("subscribePage.unsubscribed")}</h1>
				<p class="manage__result-text">{t("subscribePage.unsubscribedText")}</p>
				{outcome.email && <p class="manage__result-email">{outcome.email}</p>}
				<p class="manage__result-actions"><a href="/subscribe">{t("subscribePage.resubscribe")}</a></p>
			</div>
		) : outcome.kind === "paused" ? (
			<div class="manage__result">
				<h1 class="manage__result-title">{t("subscribeManage.heading")}</h1>
				<p class="manage__result-text">{t("subscribeManage.pausedNote")}</p>
				{outcome.email && <p class="manage__result-email">{outcome.email}</p>}
			</div>
		) : manage ? (
			<div class="manage__panel">
				<header class="manage__header">
					<h1 class="manage__title">{t("subscribeManage.heading")}</h1>
					<p class="manage__lede">{t("subscribeManage.lede")}</p>
					{manage.email && <p class="manage__email">{manage.email}</p>}
				</header>

				{manage.notice && (
					<p class="manage__notice" role="status">
						{manage.notice === "saved" ? t("subscribeManage.saved") : t("subscribeManage.saveFailed")}
					</p>
				)}

				<section class="manage__section">
					<h2 class="manage__section-title">{t("subscribeManage.groupsHeading")}</h2>
					{manage.available.length === 0 ? (
						<p class="manage__hint">{t("subscribeManage.noGroups")}</p>
					) : (
						<form method="post" class="manage__form">
							<input type="hidden" name="token" value={manage.token} />
							<input type="hidden" name="intent" value="groups" />
							<p class="manage__hint">{t("subscribeManage.groupsHint")}</p>
							{manage.available.map((group) => (
								<label class="manage__group">
									<input
										type="checkbox"
										name="groups"
										value={group.slug}
										checked={manage.groups.includes(group.slug)}
									/>
									<span class="manage__group-name">{group.name}</span>
									{group.description && <span class="manage__group-desc">{group.description}</span>}
								</label>
							))}
							<button type="submit" class="manage__button" data-press>
								{t("subscribeManage.saveGroups")}
							</button>
						</form>
					)}
				</section>

				<section class="manage__section">
					<h2 class="manage__section-title">{t("subscribeManage.cadenceHeading")}</h2>
					<form method="post" class="manage__form">
						<input type="hidden" name="token" value={manage.token} />
						<input type="hidden" name="intent" value="cadence" />
						<p class="manage__hint">{t("subscribeManage.cadenceHint")}</p>
						{manage.cadences.map((option) => (
							<label class="manage__group">
								<input
									type="radio"
									name="cadence"
									value={option.value}
									checked={manage.cadence === option.value}
								/>
								<span class="manage__group-name">{option.label}</span>
							</label>
						))}
						<button type="submit" class="manage__button" data-press>
							{t("subscribeManage.saveCadence")}
						</button>
					</form>
				</section>

				<section class="manage__section manage__section--danger">
					<h2 class="manage__section-title">{t("subscribeManage.unsubscribeHeading")}</h2>
					<form method="post" class="manage__form">
						<input type="hidden" name="token" value={manage.token} />
						<input type="hidden" name="intent" value="unsubscribe" />
						<p class="manage__hint">{t("subscribeManage.unsubscribeHint")}</p>
						<label class="manage__field">
							<span>{t("subscribeManage.reasonLabel")}</span>
							<input
								type="text"
								name="reason"
								maxlength="200"
								placeholder={t("subscribeManage.reasonPlaceholder")}
							/>
						</label>
						<button type="submit" class="manage__button manage__button--danger" data-press>
							{t("subscribeManage.confirmUnsubscribe")}
						</button>
					</form>
				</section>
			</div>
		) : null}
	</div>
</Base>

<style>
	.manage {
		padding-top: var(--spacing-12);
		max-width: 640px;
	}

	/* ---------- 结果态（居中，沿用原退订页的杂志式观感） ---------- */

	.manage__result {
		padding-top: var(--spacing-8);
		text-align: center;
	}

	.manage__result-title {
		margin: 0 0 var(--spacing-5);
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-3xl);
	}

	.manage__result-text {
		margin: 0;
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.manage__result-email {
		margin: var(--spacing-4) 0 0;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.manage__result-actions {
		margin-top: var(--spacing-8);
	}

	.manage__result-actions a {
		color: var(--color-brand);
	}

	/* ---------- 管理态 ---------- */

	.manage__header {
		text-align: center;
		padding-bottom: var(--spacing-6);
	}

	.manage__title {
		margin: 0 0 var(--spacing-3);
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-3xl);
	}

	.manage__lede {
		margin: 0;
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.manage__email {
		margin: var(--spacing-3) 0 0;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.manage__notice {
		margin: 0 0 var(--spacing-6);
		padding: var(--spacing-3) var(--spacing-4);
		background: var(--color-surface);
		border-left: 3px solid var(--color-brand);
		font-weight: 600;
	}

	.manage__section {
		margin-top: var(--spacing-8);
	}

	.manage__section-title {
		font-size: var(--font-size-lg);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-4);
	}

	.manage__section--danger {
		border-top: var(--rule-hairline);
		padding-top: var(--spacing-6);
	}

	.manage__hint {
		margin: 0 0 var(--spacing-4);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.manage__group {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-3);
		padding: var(--spacing-3) 0;
		cursor: pointer;
		border-bottom: var(--rule-hairline);
	}

	.manage__group input {
		accent-color: var(--color-brand);
		margin: 0;
	}

	.manage__group-name {
		font-weight: 600;
	}

	.manage__group-desc {
		flex-basis: 100%;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.manage__field {
		display: block;
		margin: var(--spacing-4) 0;
	}

	.manage__field span {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		margin-bottom: var(--spacing-2);
	}

	.manage__field input {
		width: 100%;
		font: inherit;
		padding: var(--spacing-3);
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border-strong);
	}

	.manage__button {
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		margin-top: var(--spacing-5);
		padding: var(--spacing-3) var(--spacing-8);
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		cursor: pointer;
	}

	.manage__button--danger {
		background: transparent;
		color: var(--color-text);
		border: 1px solid var(--color-border-strong);
	}
</style>
