---
/**
 * pulse-news 标签页：与版块页同构，标题前缀 `#`。
 */
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, decodeSlug } from "emdash";
import Base from "../../layout/Base.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import StoryGrid from "../../components/StoryGrid.astro";
import Pagination from "@shared/Pagination.astro";
import { getTranslations } from "../../../../i18n";

const PER_PAGE = 12;

const { t } = getTranslations(Astro);
const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: true });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;
if (!term) return Astro.redirect("/404");

const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);

const { entries: articles, cacheHint, hasMore } = await getEmDashCollection("articles", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: PER_PAGE,
	offset: (page - 1) * PER_PAGE,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

const title = t("list.tagTitle", { label: term.label });
---

<Base
	title={title}
	pageTitle={title}
	description={t("list.tagDescription", { label: term.label })}
	canonical={`${Astro.url.origin}/tags/${term.slug}`}
>
	<div class="container list-page">
		<header class="list-page__header">
			<SectionHeading as="h1" title={`#${term.label}`} class="list-page__heading" />
			<p class="list-page__count">{t("list.count", { count: term.count ?? articles.length })}</p>
		</header>

		{articles.length === 0 ? (
			<p class="list-page__empty">{t("list.emptyTag")}</p>
		) : (
			<StoryGrid articles={articles} />
		)}

		<Pagination page={page} hasMore={Boolean(hasMore)} basePath={`/tags/${term.slug}`} />
	</div>
</Base>

<style>
	.list-page {
		padding-top: var(--spacing-10);
	}

	.list-page__header {
		margin-bottom: var(--spacing-10);
	}

	/* 标题自带大下边距；这里的计数行要紧跟在标题下面 */
	.list-page__header .list-page__heading {
		margin-bottom: var(--spacing-4);
	}

	.list-page__count {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.list-page__empty {
		padding-block: var(--spacing-16);
		text-align: center;
		color: var(--color-muted);
	}
</style>
