---
/**
 * pulse-news 首页：杂志式三栏（设计稿 UI-2）+ 第二/第三屏。
 *
 * 第一屏（三栏）：左 SPOTLIGHT 米黄卡（4 条）；中主视觉（大图 + 超大斜体标题 + 作者卡
 * + 时间戳 + 摘要）+ 三栏小图卡；右播客区块 + 一条侧栏文章。
 * 第二/第三屏（全宽纵向堆叠）：本期精选（最新期号）/ 多媒体（video·podcast·photo）/
 * AI 话题（tag=ai）。
 *
 * 数据编排只在这里做：查询 → cacheHint → 去重取用 → 交给纯展示组件。
 * 新屏必须放在 `.front__grid` **之外**：`StoryGrid` 的列数由视口宽度决定，塞进三栏会被挤。
 */
import { getEmDashCollection, getSiteSettings } from "emdash";
import type { ArticleEntry } from "@utils/types";
import Base from "../layout/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpotlightCard from "../components/SpotlightCard.astro";
import StoryGrid from "../components/StoryGrid.astro";
import MainFeature from "../components/MainFeature.astro";
import MiniCard from "../components/MiniCard.astro";
import PodcastBlock from "../components/PodcastBlock.astro";
import AsideStory from "../components/AsideStory.astro";
import { getTranslations } from "../../../i18n";
import { resolveSiteIdentity } from "@utils/site-identity";
import { getLatestEditionArticles } from "@utils/edition";

const { t } = getTranslations(Astro);

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveSiteIdentity(settings);

const [
	latestResult,
	leadResult,
	editionResult,
	podcastResult,
	videoResult,
	photoResult,
	aiResult,
] = await Promise.all([
	getEmDashCollection("articles", { orderBy: { published_at: "desc" }, limit: 12 }),
	getEmDashCollection("articles", {
		where: { priority: "lead" },
		orderBy: { published_at: "desc" },
		limit: 1,
	}),
	// 第二屏：最新一期的文章（两段查询，见 @utils/edition）
	getLatestEditionArticles(16),
	// 第三屏：多媒体 —— 三种 article_type 各取一批再合并（不用数组 where）
	getEmDashCollection("articles", {
		where: { article_type: "podcast" },
		orderBy: { published_at: "desc" },
		limit: 8,
	}),
	getEmDashCollection("articles", {
		where: { article_type: "video" },
		orderBy: { published_at: "desc" },
		limit: 8,
	}),
	getEmDashCollection("articles", {
		where: { article_type: "photo" },
		orderBy: { published_at: "desc" },
		limit: 8,
	}),
	// 第三屏：话题
	getEmDashCollection("articles", {
		where: { tag: "ai" },
		orderBy: { published_at: "desc" },
		limit: 20,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(latestResult.cacheHint);
	Astro.cache.set(leadResult.cacheHint);
	for (const hint of editionResult.cacheHints) if (hint) Astro.cache.set(hint);
	Astro.cache.set(podcastResult.cacheHint);
	Astro.cache.set(videoResult.cacheHint);
	Astro.cache.set(photoResult.cacheHint);
	Astro.cache.set(aiResult.cacheHint);
}

const latest = latestResult.entries;
const podcast =
	podcastResult.entries[0] ??
	latest.find((article) => article.data.article_type === "podcast") ??
	null;
const feature =
	leadResult.entries[0] ?? latest.find((article) => article.id !== podcast?.id) ?? null;

// 主视觉与播客先定位再排除，其余稿子按时间顺序供给三个区块
const pool = latest.filter(
	(article) => article.id !== feature?.id && article.id !== podcast?.id,
);
const used = new Set<string | undefined>();

/**
 * 取 n 条：优先没上过版面的，不够时按设计稿补位（设计稿的区块之间本就有重复），
 * 并把这些稿子标记为已用，避免后面区块再取同一批。
 */
function take(n: number): ArticleEntry[] {
	const picked = pool.filter((article) => !used.has(article.id)).slice(0, n);
	for (const article of pool) {
		if (picked.length >= n) break;
		if (!picked.includes(article)) picked.push(article);
	}
	for (const article of picked) used.add(article.id);
	return picked;
}

const spotlight = take(4);
const minis = take(3);
const asideStory = take(1)[0] ?? null;

// 第二/第三屏：先把第一屏用过的稿子并入排除集，再按维度取用。
// 新稿的 published_at 是「导入时间」（比旧稿新），会占据「最新 12」→ 第一屏吃掉大半，
// 所以这里**只取未上版面的稿子**（不兜底重复）：宁可区块少几条，也不要同一篇大图卡出现两次。
// 因此各维度查询的 limit 要足够大，才能越过被第一屏占用的那批、拿到后面的新鲜稿。
const placed = new Set<string | undefined>([feature?.id, podcast?.id, ...used]);

function pickFresh(entries: ArticleEntry[], n: number): ArticleEntry[] {
	const picked = entries.filter((article) => !placed.has(article.id)).slice(0, n);
	for (const article of picked) placed.add(article.id);
	return picked;
}

// 多媒体：video → podcast → photo（稀缺类型先露面）
const multimediaPool = [...videoResult.entries, ...podcastResult.entries, ...photoResult.entries];

const editionPicks = pickFresh(editionResult.entries, 6);
const multimedia = pickFresh(multimediaPool, 6);
const aiTopic = pickFresh(aiResult.entries, 6);
---

<Base title={siteTitle} description={siteTagline} type="website">
	<div class="container front">
		<SectionHeading as="h1" title={t("pn.latestUpdates")} />

		<div class="front__grid">
			<SpotlightCard class="front__spotlight" articles={spotlight} title={t("pn.spotlight")} />

			<div class="front__main">
				{feature && <MainFeature article={feature} />}

				{
					minis.length > 0 && (
						<div class="front__minis" data-reveal data-reveal-stagger>
							{minis.map((article) => (
								<MiniCard article={article} />
							))}
						</div>
					)
				}
			</div>

			<aside class="front__aside" data-reveal data-reveal-stagger>
				{podcast && <PodcastBlock article={podcast} />}

				{asideStory && <AsideStory article={asideStory} />}
			</aside>
		</div>

		{
			editionPicks.length > 0 && (
				<section class="front__section">
					<SectionHeading title={t("pn.editionPicks")} />
					<StoryGrid articles={editionPicks} />
				</section>
			)
		}

		{
			multimedia.length > 0 && (
				<section class="front__section">
					<SectionHeading title={t("pn.multimedia")} />
					<StoryGrid articles={multimedia} />
				</section>
			)
		}

		{
			aiTopic.length > 0 && (
				<section class="front__section">
					<SectionHeading title={t("pn.aiTopic")} />
					<StoryGrid articles={aiTopic} />
				</section>
			)
		}
	</div>
</Base>

<style>
	.front {
		padding-top: var(--spacing-10);
	}

	.front__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-10);
	}

	/* 第二/第三屏：全宽纵向堆叠，用粗分隔线拉开杂志式节奏 */
	.front__section {
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-10);
		border-top: var(--rule-thick);
	}

	.front__main {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-10);
		min-width: 0;
	}

	.front__minis {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-6);
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border);
	}

	.front__aside {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-10);
		min-width: 0;
	}

	/* 右栏第二个区块才画分隔线（首块上方不画，避免孤零零一条横线） */
	.front__aside > * + * {
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border-strong);
	}

	@media (min-width: 640px) {
		.front__minis {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1040px) {
		.front__grid {
			grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
			gap: var(--spacing-10);
			align-items: start;
		}
	}
</style>
