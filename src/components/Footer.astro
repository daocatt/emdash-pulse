---
import type { MenuItem } from "emdash";

interface Props {
	items: MenuItem[];
	siteTitle: string;
	class?: string;
}

const { items, siteTitle, class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["site-footer", className]}>
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<span class="site-footer__title">{siteTitle}</span>
			<p class="site-footer__copy">© {year} {siteTitle} · 由 Agent 与编辑协作产出</p>
		</div>

		<nav class="site-footer__nav" aria-label="页脚导航">
			<ul class="site-footer__list">
				{items.map((item) => (
					<li><a class="site-footer__link" href={item.url} target={item.target}>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="site-footer__feeds">
			<a href="/rss.xml">RSS</a>
			<a href="/feed.json">JSON Feed</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--spacing-16);
		border-top: var(--rule-thick);
		background: var(--color-bg-subtle);
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-6);
		padding-block: var(--spacing-10);
	}

	.site-footer__title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: 700;
	}

	.site-footer__copy {
		margin: var(--spacing-2) 0 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.site-footer__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-5);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer__link {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.site-footer__link:hover {
		color: var(--color-brand);
		text-decoration: underline;
	}

	.site-footer__feeds {
		display: flex;
		gap: var(--spacing-4);
		font-size: var(--font-size-sm);
	}

	.site-footer__feeds a {
		color: var(--color-brand);
	}
</style>
