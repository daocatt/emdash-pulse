---
import type { ArticleEntry } from "../utils/types";
import StoryCard from "./StoryCard.astro";

interface Props {
	/** 版块显示名（如「要闻」）。 */
	title: string;
	/** 版块链接（如 /sections/top）。 */
	href: string;
	articles: ArticleEntry[];
	class?: string;
}

const { title, href, articles, class: className } = Astro.props;
const [lead, ...rest] = articles;
---

{articles.length > 0 && (
	<section class:list={["section-block", className]}>
		<header class="section-block__header">
			<h2 class="section-block__title">
				<a href={href}>{title}</a>
			</h2>
			<a class="section-block__more" href={href}>更多 {title} →</a>
		</header>

		<div class="section-block__grid">
			{lead && (
				<div class="section-block__lead">
					<StoryCard article={lead} showImage size="lg" headingLevel="h3" />
				</div>
			)}

			{rest.length > 0 && (
				<ul class="section-block__list">
					{rest.map((article) => (
						<li>
							<StoryCard article={article} size="sm" headingLevel="h3" />
						</li>
					))}
				</ul>
			)}
		</div>
	</section>
)}

<style>
	.section-block {
		padding-block: var(--spacing-8);
		border-top: var(--rule-double);
	}

	.section-block__header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-6);
	}

	.section-block__title {
		font-size: var(--font-size-2xl);
	}

	.section-block__title a:hover {
		color: var(--color-brand);
	}

	.section-block__more {
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		white-space: nowrap;
	}

	.section-block__grid {
		display: grid;
		gap: var(--spacing-8);
	}

	@media (min-width: 900px) {
		.section-block__grid {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.section-block__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.section-block__list > li + li {
		padding-top: var(--spacing-5);
		border-top: var(--rule-hairline);
	}
</style>
