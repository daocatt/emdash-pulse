---
/**
 * 署名行：小头像（或首字色块）+ 姓名 + · 角色（+ · 日期）。
 *
 * 单行内联排布，不占独立板块（早先是「大圆头像 + 大字号 + 米黄卡片」，
 * 视觉重量过大）。两套主题共用，靠令牌换肤。
 */
import type { BylineSummary } from "emdash";
import { getTranslations } from "../i18n";
import { bylineAvatarUrl, bylineInitials } from "../utils/byline";
import { formatDate, toDate } from "../utils/format";

interface Props {
	byline: BylineSummary;
	/** 署名角色（credit.roleLabel），为空时退回到「撰稿人」。 */
	roleLabel?: string | null;
	date?: Date | string | null;
	size?: "sm" | "md";
	/** 只展示头像 + 姓名（无角色 / 日期）。 */
	compact?: boolean;
	class?: string;
}

const {
	byline,
	roleLabel,
	date,
	size = "md",
	compact = false,
	class: className,
} = Astro.props;

const { locale, t } = getTranslations(Astro);
const avatarUrl = bylineAvatarUrl(byline);
const initials = bylineInitials(byline.displayName);
const role = roleLabel ?? t("pn.contributor");
// 通讯社署名（如 displayName = roleLabel = 「综合报道」）不必重复显示角色。
const showRole = !compact && role.trim() !== byline.displayName.trim();
const dateValue = toDate(date);
const dateLabel = dateValue ? formatDate(dateValue, locale) : null;
---

<div class:list={["author-card", `author-card--${size}`, className]}>
	{
		avatarUrl ? (
			<img
				class="author-card__avatar"
				src={avatarUrl}
				alt={byline.avatarAlt ?? byline.displayName}
				width="28"
				height="28"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="author-card__avatar author-card__avatar--initials" aria-hidden="true">
				{initials}
			</span>
		)
	}

	<span class="author-card__name">{byline.displayName}</span>

	{showRole && <span class="author-card__role">{role}</span>}

	{
		!compact && dateLabel && dateValue && (
			<time class="author-card__date" datetime={dateValue.toISOString()}>
				{dateLabel}
			</time>
		)
	}
</div>

<style>
	.author-card {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-muted);
	}

	.author-card__avatar {
		flex: none;
		width: 28px;
		height: 28px;
		margin-inline-end: var(--spacing-2);
		border-radius: 50%;
		object-fit: cover;
		background: var(--color-bg-subtle);
	}

	.author-card--sm .author-card__avatar {
		width: 22px;
		height: 22px;
	}

	.author-card__avatar--initials {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--color-brand-soft);
		color: var(--color-text);
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-xs);
	}

	.author-card__name {
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-base);
		color: var(--color-text);
	}

	.author-card--sm .author-card__name {
		font-size: var(--font-size-sm);
	}

	/* 分隔点由 CSS 生成：角色 / 日期缺省时不会留下孤立的「·」。 */
	.author-card__role::before,
	.author-card__date::before {
		content: "·";
		margin-inline: var(--spacing-2);
		opacity: 0.55;
	}

	.author-card__role {
		font-style: italic;
	}

	.author-card__date {
		white-space: nowrap;
	}
</style>
