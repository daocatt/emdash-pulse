{
  "name": "suda-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "workspaces": [
    "plugins/pulse-review",
    "plugins/pulse-agent",
    "plugins/pulse-editorial",
    "plugins/pulse-subscriptions"
  ],
  "scripts": {
    "plugin:build": "npm run build --workspaces",
    "plugin:test": "npm run test --workspaces",
    "dev": "npm run plugin:build && astro dev",
    "build": "npm run plugin:build && astro build",
    "build:cf": "npm run plugin:build && DEPLOY_TARGET=cloudflare astro build",
    "deploy": "npm run plugin:build && DEPLOY_TARGET=cloudflare astro build && wrangler deploy",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@emdash-cms/plugin-ai-moderation": "^0.2.2",
    "@emdash-cms/plugin-audit-log": "^0.2.3",
    "astro": "^7.3.2",
    "emdash": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emdash-cms/sandbox-workerd": "^0.9.2",
    "wrangler": "^4.145.0"
  }
}
