# ============================================================================
# Suda Pulse —— 环境变量模板（VPS / Docker 部署）
# 复制为 .env 后填写：cp .env.example .env
# 真实 .env 永不提交（见 .gitignore）。
# ============================================================================

# ---- 插件密钥加密（必填）----
# 加密声明为 secret 的插件设置（如 Resend API key）。
# 生成：npx emdash secret
EMDASH_ENCRYPTION_KEY=

# ---- 站点公开地址（反代 / 容器部署必填）----
# 影响 canonical / Passkey / CSRF / MCP 发现 / sitemap。用本地存储时构建期也要给
# （Dockerfile 的 EMDASH_SITE_URL 构建参数），否则图片不做优化。
EMDASH_SITE_URL=https://pulse.example.com

# ---- 前台主题默认值（构建期，可选）----
# news-factory | pulse-news；只在后台「前台主题」页从未设置过时生效。
SITE_THEME=news-factory

# ---- Docker 数据目录与宿主端口（compose 用）----
# 数据落在这个宿主目录下：postgres/ app/（本地媒体+会话） redis/。
# 便于直接备份 / 迁移；相对路径相对仓库根。生产建议绝对路径，如 /srv/pulse/data。
DOCKER_DATA_PATH=./data
# pulse-app 绑到宿主回环的端口（宿主反代转发到这里）。
APP_PORT=4321
# pulse-db 绑到宿主回环的端口（供 psql / pg_dump 用，不对外暴露）。
DB_PORT=5432
# 容器时区（站点按 Asia/Shanghai 发布）。
TZ=Asia/Shanghai

# ---- PostgreSQL（compose 用；pulse-app 会自动拼出 DATABASE_URL 与 PG*）----
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulse
# 本地 `npm run dev`（不走 compose）时，二选一：
#   DATABASE_URL=postgres://pulse:change-me@localhost:5432/pulse
# 或标准 libpq 变量（运行期连接池读这些）：
#   PGHOST=localhost
#   PGPORT=5432
#   PGDATABASE=pulse
#   PGUSER=pulse
#   PGPASSWORD=change-me

# ---- Redis（对象缓存）----
# 容器内由 compose 注入 redis://pulse-redis:6379；本地 dev 指向本机。
# 未设置时对象缓存自动降级为直通（无缓存）。
# REDIS_URL=redis://localhost:6379

# ---- 媒体存储：S3 / R2（可选）----
# 构建期只要 S3_ENDPOINT 非空即启用 s3() 适配器（R2 是 S3 兼容的）。
# 六个变量都在**运行期**读取；只配 S3_ENDPOINT 决定「用 s3 还是本地磁盘」。
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=pulse-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=https://media.example.com   # 配了则媒体直连 CDN/R2 自定义域

# ---- 反向代理下取真实客户端 IP ----
# 限流 / 订阅按 IP 计数；不设会按代理 IP 计。
EMDASH_TRUSTED_PROXY_HEADERS=x-forwarded-for

# ---- GitHub 登录（可选）----
# GitHub → Settings → Developer settings → OAuth Apps，回调填：
#   https://<站点域名>/_emdash/api/auth/oauth/github/callback
# 未配置时登录页不显示「Sign in with GitHub」，不影响其余功能。
# EMDASH_OAUTH_GITHUB_CLIENT_ID=
# EMDASH_OAUTH_GITHUB_CLIENT_SECRET=
