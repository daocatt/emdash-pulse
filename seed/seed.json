        { "slug": "title", "label": "标题", "type": "string", "required": true, "searchable": true },
        { "slug": "deck", "label": "导语", "type": "text", "searchable": true },
        { "slug": "content", "label": "正文", "type": "portableText", "required": true, "searchable": true },
