{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "pulse-subscriptions",
	"publisher": "did:plc:zp6y7q3n5k2m4x8w9v1t6r0s",

	"license": "MIT",
	"author": { "name": "Suda Pulse", "email": "dev@suda.im" },
	"security": { "email": "dev@suda.im" },
	"description": "Suda Pulse reader subscriptions: double opt-in, unsubscribe, subscriber list",

	// Trust contract — what runtime APIs the plugin asks for.
	// - email:send → 发送确认 / 欢迎（含退订链接）邮件。未配置 provider 时降级为
	//   在订阅记录里留 `pendingEmail`，不报错。
	// - network:request → 直连 Resend REST（segments / contacts / broadcasts）与
	//   接收 Webhook（`resend/webhook`，Svix 验签）。凭证复用「Resend」插件的设置
	//   （plugin id `emdash-resend`），本插件不重复配置 API key。
	// - content:read → 摘要任务读取 `articles` 集合（按发布时间窗口取数）。
	// 订阅者身份存于插件存储 `subscribers`，不是 EmDash 用户，故无需 users 能力。
	"capabilities": ["email:send", "network:request", "content:read"],
	"allowedHosts": ["api.resend.com"],
	"storage": {
		"subscribers": {
			"indexes": ["status", "createdAt", "tokenHash"],
			"uniqueIndexes": ["emailHash"]
		},
		// 订阅分组。`slug` 同时是记录 id（创建后不可变）。
		"groups": {
			"indexes": ["active", "sortOrder"]
		},
		// 订阅事件日志（append-only）：后台按订阅者回放时间线。
		// 事件记录**不含** emailHash —— subscribers 的 uniqueIndexes 生成的是覆盖全表的
		// 唯一索引（plugin_id, collection, json_extract(data,'$.emailHash')），
		// 同名字段会让同一订阅者的第 2 条事件撞唯一约束而写不进去。
		"events": {
			"indexes": ["subscriberId", "type", "at"]
		},
		// 群发历史（Resend Broadcasts 的本地留痕）：后台「订阅群发」页展示。
		"broadcasts": {
			"indexes": ["createdAt"]
		},
		// 摘要运行留痕（每周 / 每月）：既是后台展示的历史，也是「同一周期不重发」的
		// 幂等判据（见 src/digest.ts）。**不声明 unique** —— cadence / sentAt 天然会
		// 重复，而同集合内重复值会撞 uniqueIndexes 建出的唯一索引。
		"digest_runs": {
			"indexes": ["cadence", "sentAt"]
		}
	},
	"admin": {
		"pages": [
			{ "path": "/subscribers", "label": "订阅者", "icon": "mail" },
			{ "path": "/groups", "label": "订阅分组", "icon": "tag" },
			{ "path": "/broadcast", "label": "订阅群发", "icon": "send" },
			{ "path": "/digest", "label": "订阅摘要", "icon": "calendar" }
		],
		"settingsSchema": {
			"autoConfirm": {
				"label": "免确认直接订阅（单确认）",
				"description": "开启后跳过双确认邮件，提交即视为已订阅。未配置邮件服务时可临时开启以便测试。",
				"type": "boolean",
				"default": false
			},
			"replyTo": {
				"label": "回复地址（Reply-To）",
				"description": "订阅邮件的回复地址，留空则用站点默认发件地址。",
				"type": "string",
				"default": ""
			},
			"confirmSubject": {
				"label": "确认邮件主题",
				"type": "string",
				"default": "确认订阅 Suda Pulse"
			},
			"welcomeSubject": {
				"label": "欢迎邮件主题",
				"type": "string",
				"default": "欢迎订阅 Suda Pulse"
			},
			"confirmPath": {
				"label": "确认页路径",
				"description": "确认邮件里链接指向的站点路径。",
				"type": "string",
				"default": "/subscribe/confirm"
			},
			"unsubscribePath": {
				"label": "退订页路径",
				"description": "欢迎 / 退订邮件里链接指向的站点路径。",
				"type": "string",
				"default": "/subscribe/unsubscribe"
			},
			"broadcastProvider": {
				"label": "群发投递通道",
				"description": "群发与分组同步使用的邮件服务（见 src/transport/）。目前支持 Resend（复用「Resend」页的 API Key）。",
				"type": "select",
				"options": [{ "value": "resend", "label": "Resend" }],
				"default": "resend"
			},
			"digestEnabled": {
				"label": "启用订阅摘要",
				"description": "开启后按下方时间自动向订阅者发送每周 / 每月内容摘要。关闭会取消已注册的定时任务。",
				"type": "boolean",
				"default": true
			},
			"defaultCadence": {
				"label": "默认订阅节奏",
				"description": "订阅者未显式选择节奏时使用的档位。",
				"type": "select",
				"options": [
					{ "value": "weekly", "label": "每周" },
					{ "value": "monthly", "label": "每月" }
				],
				"default": "weekly"
			},
			"weeklySchedule": {
				"label": "周报时间（UTC cron）",
				"description": "标准 cron 表达式，时区固定 UTC。本站 CST = UTC+8，故 `0 0 * * 1` = 周一 08:00。",
				"type": "string",
				"default": "0 0 * * 1"
			},
			"monthlySchedule": {
				"label": "月报时间（UTC cron）",
				"description": "标准 cron 表达式，时区固定 UTC。本站 CST = UTC+8，故 `0 0 1 * *` = 每月 1 日 08:00。",
				"type": "string",
				"default": "0 0 1 * *"
			},
			"digestMaxArticles": {
				"label": "单期最多文章数",
				"description": "每期摘要最多列出多少篇文章（超出按头条 / 权重 / 时间排序截取）。",
				"type": "number",
				"default": 12
			},
			"weeklySubject": {
				"label": "周报主题",
				"description": "支持占位符 {site}（站点名）与 {count}（文章数）。",
				"type": "string",
				"default": "本周回顾 · {site}"
			},
			"monthlySubject": {
				"label": "月报主题",
				"description": "支持占位符 {site}（站点名）与 {count}（文章数）。",
				"type": "string",
				"default": "本月回顾 · {site}"
			},
			"resendSyncEnabled": {
				"label": "同步订阅到 Resend",
				"description": "开启后，订阅者状态变更会同步为 Resend 联系人（分组 → segment）。需先在「Resend」页配置 API Key。",
				"type": "boolean",
				"default": true
			},
			"resendSegmentPrefix": {
				"label": "Resend segment 名称前缀",
				"description": "同一个 Resend 账号被多环境共用时，用前缀避免 segment 撞名。",
				"type": "string",
				"default": "Pulse · "
			},
			"resendWebhookSecret": {
				"label": "Resend Webhook 签名密钥",
				"description": "Resend 后台 Webhook 的 Svix 签名密钥（whsec_…）。留空则关闭回执处理（resend/webhook 返回 503）。",
				"type": "secret",
				"default": ""
			}
		}
	}
}
